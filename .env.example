# --- Required ---
SECRET_KEY=replace-with-32+chars-random-hex-or-openssl-rand
ADMIN_PASSWORD=change-me

# --- Storage ---
# On Railway, attach a Volume at /data. Falls back to /data/we.db (SQLite).
# If you attach Railway Postgres, set DATABASE_URL to:
#   postgresql+asyncpg://USER:PASS@HOST:PORT/DB
DATABASE_URL=sqlite+aiosqlite:////data/we.db

# --- Polling ---
POLL_INTERVAL_MINUTES=15

# --- Alerts (n8n) ---
# Production webhook URL from your n8n instance
N8N_WEBHOOK_URL=https://n8n.engosoft.com/webhook/we-quota-alert

# --- Geo proxy (REQUIRED on Railway — api-my.te.eg is Egypt-only) ---
# Point this to a proxy server running in Egypt (HTTP or SOCKS5).
# Example with HTTP proxy:  WE_PROXY_URL=http://user:pass@your-vps:8080
# Example with SOCKS5:      WE_PROXY_URL=socks5://user:pass@your-vps:1080
# Leave empty when deploying on Fly.io Cairo region (cai) — no proxy needed.
WE_PROXY_URL=

# --- Misc ---
ALLOWED_ORIGINS=*
SERVE_FRONTEND=true
FRONTEND_DIST=/app/frontend_dist

# --- Bulk seed (runs ONCE on first startup when accounts table is empty) ---
# JSON array — each item: landline (with leading 0), password, label (optional)
# After the first boot this env var is ignored (accounts already exist in DB)
# Example:
# ACCOUNTS_SEED=[{"landline":"0212345678","password":"pass1","label":"Home"},{"landline":"0387654321","password":"pass2","label":"Office"}]
ACCOUNTS_SEED=
